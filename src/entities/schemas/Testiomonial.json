{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string",
      "description": "ID do membro que deu o depoimento"
    },
    "draw_id": {
      "type": "string",
      "description": "ID do sorteio relacionado"
    },
    "campaign_id": {
      "type": "string",
      "description": "ID da campanha relacionada"
    },
    "author_name": {
      "type": "string"
    },
    "author_photo_url": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Avalia\u00e7\u00e3o de 1 a 5 estrelas"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do depoimento"
    },
    "content": {
      "type": "string",
      "description": "Conte\u00fado do depoimento"
    },
    "prize_won": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do pr\u00eamio ganho"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto do vencedor com o pr\u00eamio"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status de modera\u00e7\u00e3o"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Destacar na home"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "author_name",
    "content",
    "rating"
  ]
}